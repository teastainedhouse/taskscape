# Copy to .env (gitignored) or set in the host's environment.

# Database. SQLite for local dev; PostgreSQL in production.
TASKSCAPE_DATABASE_URL=sqlite:./data/dev.db
# TASKSCAPE_DATABASE_URL=postgres://user:password@host:5432/taskscape

# Identity provider: "dev" (switchable local users) or "headers" (SSO headers from the host).
TASKSCAPE_AUTH_PROVIDER=dev

# Set to "production" on a real host. Refuses to start with the dev provider.
TASKSCAPE_ENV=development

# Path to the config file (default: ./taskscape.config.json).
# TASKSCAPE_CONFIG=./taskscape.config.json

# Local dev server port.
PORT=3000

# For the MCP server (mcp/server.js): API origin and a personal token from the Tokens page.
# TASKSCAPE_URL=http://localhost:3000
# TASKSCAPE_TOKEN=tsk_...
